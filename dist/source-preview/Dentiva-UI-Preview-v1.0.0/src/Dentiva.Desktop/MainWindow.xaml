<Window x:Class="Dentiva.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dentiva" Width="1440" Height="900" MinWidth="1024" MinHeight="640" Background="#F7F9FB"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Navy}"><StackPanel Margin="18,28"><TextBlock Text="DENTIVA" Foreground="White" FontSize="21" FontWeight="Bold" Margin="10,0,0,40"/><TextBlock Text="WORKSPACE" Foreground="#79A4B8" FontSize="10" Margin="10,0,0,10"/><Button Content="Dashboard" Foreground="White" Background="#1E4967" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/><Button Content="Patients" Foreground="#C7D8E5" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/><Button Content="Appointments" Foreground="#C7D8E5" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/><Button Content="Clinical" Foreground="#C7D8E5" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/><Button Content="Billing & Finance" Foreground="#C7D8E5" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/><Button Content="Reports" Foreground="#C7D8E5" Background="Transparent" BorderThickness="0" Padding="12" HorizontalContentAlignment="Left"/></StackPanel></Border><DockPanel Grid.Column="1"><Border DockPanel.Dock="Top" Background="White" BorderBrush="#E7EDF2" BorderThickness="0,0,0,1" Padding="30,22"><TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold"/></Border><ScrollViewer Padding="38"><StackPanel><TextBlock Text="TODAY" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold" Margin="0,12,0,7"/><TextBlock Text="Good morning." Foreground="{StaticResource Navy}" FontSize="30" FontWeight="Bold"/><TextBlock Text="Your